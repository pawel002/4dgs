\@writefile{lof}{\contentsline {figure}{\numberline {3.5}{\ignorespaces Camera coordinate conventions. Blender (left) looks along local $-z$ with $y$ up. The OpenCV/SfM convention (right) looks along $+z$ with $y$ down. The two differ by $\mathbf  {R}_{\text  {flip}} = \mathrm  {diag}(1,-1,-1)$, reconciled once at load time.}}{28}{figure.caption.21}\protected@file@percent }
\newlabel{fig:coord}{{3.5}{28}{Camera coordinate conventions. Blender (left) looks along local $-z$ with $y$ up. The OpenCV/SfM convention (right) looks along $+z$ with $y$ down. The two differ by $\mathbf {R}_{\text {flip}} = \mathrm {diag}(1,-1,-1)$, reconciled once at load time}{figure.caption.21}{}}
