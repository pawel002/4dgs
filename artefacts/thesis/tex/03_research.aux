\@writefile{lot}{\contentsline {table}{\numberline {3.3}{\ignorespaces Rate-distortion sweep of the temporal compressor on the full 150-frame, $11\,561$-primitive sequence ($430$\,MB raw).}}{65}{table.caption.53}\protected@file@percent }
\newlabel{tab:compression}{{3.3}{65}{Rate-distortion sweep of the temporal compressor on the full 150-frame, $11\,561$-primitive sequence ($430$\,MB raw)}{table.caption.53}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.3.11}The Improved Pipeline End to End}{65}{subsection.3.3.11}\protected@file@percent }
\newlabel{sec:results-improved}{{3.3.11}{65}{The Improved Pipeline End to End}{subsection.3.3.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.32}{\ignorespaces Temporal compression of the full sequence. (a)~Rate-distortion front swept by the single quality knob $q$. The default operating point is marked. (b)~Retained DCT coefficients per time-varying attribute at the default $q$, where the smooth positions need a small fraction of the 150 coefficients, while the noisy opacity, scale, and rotation channels hit the cap. All colour attributes are stored losslessly by the constant mode and the normals by the zero mode, so neither appears in the budget.}}{66}{figure.caption.54}\protected@file@percent }
\newlabel{fig:rate-distortion}{{3.32}{66}{Temporal compression of the full sequence. (a)~Rate-distortion front swept by the single quality knob $q$. The default operating point is marked. (b)~Retained DCT coefficients per time-varying attribute at the default $q$, where the smooth positions need a small fraction of the 150 coefficients, while the noisy opacity, scale, and rotation channels hit the cap. All colour attributes are stored losslessly by the constant mode and the normals by the zero mode, so neither appears in the budget}{figure.caption.54}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3.4}{\ignorespaces The improvement mechanisms, alone and combined, over the full 150-frame sequence (means over frames; extent at the last frame). PSNR stays inside the illumination-gap band throughout and does not discriminate. Note the interactions. The snap margin alone hurts (its gentleness exposes the mask noise the blunt clamp was compensating for), and the smoothness prior alone costs structure, yet the combination is the best configuration measured. The primitive count is set by frame-0 densification and varies with the mask fullness and run stochasticity.}}{66}{table.caption.55}\protected@file@percent }
\newlabel{tab:improved}{{3.4}{66}{The improvement mechanisms, alone and combined, over the full 150-frame sequence (means over frames; extent at the last frame). PSNR stays inside the illumination-gap band throughout and does not discriminate. Note the interactions. The snap margin alone hurts (its gentleness exposes the mask noise the blunt clamp was compensating for), and the smoothness prior alone costs structure, yet the combination is the best configuration measured. The primitive count is set by frame-0 densification and varies with the mask fullness and run stochasticity}{table.caption.55}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.33}{\ignorespaces The improved pipeline against the v2 baseline, per frame. (a)~Object PSNR: both arms ride the illumination-gap envelope of the input reference. The improved arm's cleaner masks admit slightly less bounce light mid-sequence. (b)~Object SSIM, where the improved arm is markedly more stable, winning precisely in the camouflage window (early frames) and the stray-accumulation regime (late frames) that the baseline's mechanisms mishandled.}}{67}{figure.caption.56}\protected@file@percent }
\newlabel{fig:improved-summary}{{3.33}{67}{The improved pipeline against the v2 baseline, per frame. (a)~Object PSNR: both arms ride the illumination-gap envelope of the input reference. The improved arm's cleaner masks admit slightly less bounce light mid-sequence. (b)~Object SSIM, where the improved arm is markedly more stable, winning precisely in the camouflage window (early frames) and the stray-accumulation regime (late frames) that the baseline's mechanisms mishandled}{figure.caption.56}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.3.12}Iteration Budget}{67}{subsection.3.3.12}\protected@file@percent }
\newlabel{sec:results-budget}{{3.3.12}{67}{Iteration Budget}{subsection.3.3.12}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3.5}{\ignorespaces Iteration-budget sweep of the improved pipeline (150 frames, full resolution, single GPU). Quality is flat across a ${9.3\times }$ range of wall-clock, so the generous budget was headroom, not necessity.}}{68}{table.caption.57}\protected@file@percent }
\newlabel{tab:budget}{{3.5}{68}{Iteration-budget sweep of the improved pipeline (150 frames, full resolution, single GPU). Quality is flat across a ${9.3\times }$ range of wall-clock, so the generous budget was headroom, not necessity}{table.caption.57}{}}
