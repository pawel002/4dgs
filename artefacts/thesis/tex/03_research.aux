\newlabel{eq:geodesic}{{3.14}{31}{Shadow-Aware Hysteresis Segmentation}{equation.3.14}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.7}{\ignorespaces Shadow-aware hysteresis segmentation. (a)~Two thresholds split the change magnitude into a rejected band, a conditionally kept weak band, and an unconditionally kept strong band. (b)~A weak region is admitted only if it is not shadow-like (Eq.~\eqref  {eq:shadowlike}) and geodesically connected to strong evidence (Eq.~\eqref  {eq:geodesic}): the camouflaged lower body attaches to the detected torso and is kept, while the cast shadow is vetoed, disconnected, and dropped.}}{32}{figure.caption.23}\protected@file@percent }
\newlabel{fig:hysteresis}{{3.7}{32}{Shadow-aware hysteresis segmentation. (a)~Two thresholds split the change magnitude into a rejected band, a conditionally kept weak band, and an unconditionally kept strong band. (b)~A weak region is admitted only if it is not shadow-like (Eq.~\eqref {eq:shadowlike}) and geodesically connected to strong evidence (Eq.~\eqref {eq:geodesic}): the camouflaged lower body attaches to the detected torso and is kept, while the cast shadow is vetoed, disconnected, and dropped}{figure.caption.23}{}}
